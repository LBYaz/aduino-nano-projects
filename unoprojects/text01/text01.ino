void page1() {
  u8g2.drawXBMP(0, 0, 80, 16, bitmap1);
  u8g2.drawXBMP(0, 16, 64, 16, bitmap2);
  u8g2.drawXBMP(0, 32, 80, 16, bitmap);
  u8g2.drawXBMP(0, 48, 80, 16, bitmap4);
  u8g2.setFont(u8g2_font_timR10_tf);
  u8g2.setFontPosTop();
  u8g2.setCursor(71,32);
  u8g2.print(dht2.readTemperature());
  u8g2.drawXBMP(113, 32, 16, 16, bitmap5);
  u8g2.setCursor(71,48);
  u8g2.print(dht2.readHumidity());
  u8g2.drawXBMP(113, 48, 16, 16, bitmap6);
}

void setup(){
  u8g2.setI2CAddress(0x3C*2);
  u8g2.begin();
  Serial.begin(9600);
   dht2.begin();
  u8g2.enableUTF8Print();

}

void loop(){
  u8g2.firstPage();
  do
  {
    page1();
  }while(u8g2.nextPage());

}